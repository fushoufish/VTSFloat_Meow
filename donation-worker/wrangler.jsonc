{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vtsfloat-meow-support",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "vars": {
    "STRIPE_MODE": "live",
    "RETURN_URLS": {
      "https://fushoufish.github.io": "https://fushoufish.github.io/VTSFloat_Meow/support.html",
      "https://vtsfloatmeow.edgeone.dev": "https://vtsfloatmeow.edgeone.dev/docs/support.html"
    }
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
